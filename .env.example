# ==========================================
# CompX - Environment Variables Configuration
# ==========================================

# Database Connection
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL / Supabase / Neon):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[EP-NAME].neon.tech/compx?sslmode=require"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secrets
NEXTAUTH_SECRET="compx-production-secure-nextauth-secret-key-minimum-32-chars"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="compx-production-jwt-token-signing-secret-key-minimum-32-chars"

# Initial Super Admin Seed Credentials
ADMIN_EMAIL="admin@compx.in"
ADMIN_PASSWORD="AdminPassword@123"
SUPER_ADMIN_EMAIL="superadmin@compx.in"
SUPER_ADMIN_PASSWORD="SuperAdmin@123"

# UPI & Payment Defaults (can also be edited in /admin/settings)
DEFAULT_UPI_ID="compx@upi"
DEFAULT_PAYEE_NAME="CompX Education"
DEFAULT_WHATSAPP_NUMBER="919876543210"

# Razorpay (Optional - for instant gateway mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Storage Configuration (Default: 'local' for zero-setup, or 'supabase' / 's3')
STORAGE_DRIVER="local"

# Supabase Storage (Optional)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET_PUBLIC="covers"
SUPABASE_BUCKET_PRIVATE="notes-private"

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_PUBLIC="compx-public"
AWS_S3_BUCKET_PRIVATE="compx-private"

# Email SMTP Notification Settings (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CompX Education <no-reply@compx.in>"

# Groq AI Chatbot API Key
GROQ_API_KEY="gsk_your_groq_api_key_here"
